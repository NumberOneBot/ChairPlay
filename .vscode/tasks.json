{
  // Terminal > Run Task, or the Gradle panel for the Gradle tasks themselves.
  // The app has no console, its log is in its logs folder: stop it by closing the CarPlay window.
  // Never end it with VS Code's "Terminate Task" or Task Manager: a hard kill leaves the iPhone ignoring
  // new sessions until it is restarted.
  "version": "2.0.0",
  "windows": {
    "options": { "shell": { "executable": "cmd.exe", "args": ["/d", "/c"] } }
  },
  "tasks": [
    {
      "label": "Test",
      "type": "shell",
      "command": ".\\gradlew.bat check",
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "Build app image",
      "type": "shell",
      "command": ".\\gradlew.bat jpackageImage",
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": []
    },
    {
      "label": "Deploy",
      "detail": "Builds the app into dist\\ChairPlay, or the chairplay.home path, keeping settings and keys. Close the app first.",
      "type": "shell",
      "command": ".\\gradlew.bat deploy",
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "Run ChairPlay",
      "detail": "Starts the deployed app (dist\\ChairPlay or chairplay.home) without a console; close the CarPlay window to stop it.",
      "type": "shell",
      "command": ".\\gradlew.bat -q launchApp",
      "presentation": { "reveal": "never" },
      "problemMatcher": []
    },
    {
      "label": "Deploy and run",
      "dependsOrder": "sequence",
      "dependsOn": ["Deploy", "Run ChairPlay"],
      "problemMatcher": []
    },
    {
      "label": "List devices",
      "detail": "Bluetooth radio, paired devices, sound outputs and inputs.",
      "type": "shell",
      "command": ".\\gradlew.bat -q listDevices",
      "problemMatcher": []
    },
    {
      "label": "Stop Gradle daemon",
      "type": "shell",
      "command": ".\\gradlew.bat --stop",
      "problemMatcher": []
    }
  ]
}
